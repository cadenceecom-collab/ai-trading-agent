# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Trading connectors — web/cloud architecture
# IBKR Web API/OAuth. Do not use localhost Client Portal Gateway in Vercel.
IBKR_API_URL=https://api.ibkr.com
IBKR_CLIENT_ID=
IBKR_ACCOUNT_ID=
IBKR_CLIENT_ASSERTION=
IBKR_ACCESS_TOKEN=

# Crypto exchange credentials are server-only.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Coinbase Advanced Trade: CDP API key name/ID and private key secret.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Bitget demo credentials; create the key in Demo Trading mode.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# AI provider
OPENAI_API_KEY=

# Safety defaults
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
