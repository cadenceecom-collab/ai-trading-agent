# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Trading connectors (paper mode first)
# Retail IBKR Client Portal Gateway: https://localhost:5000/v1/api
IBKR_API_URL=https://localhost:5000/v1/api
IBKR_CLIENT_ID=
IBKR_ACCOUNT_ID=
# Kraken API credentials are server-only; public market data does not require them.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# AI provider
OPENAI_API_KEY=

# Safety defaults
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
